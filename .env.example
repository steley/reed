# Reed API — credentials
# DATABASE_URL:      Neon postgresql:// connection string (production branch)
# TEST_DATABASE_URL: a throwaway Neon branch for vitest (tests wipe all data)
# AUTH_SECRET:       random string used to sign session JWTs (openssl rand -hex 32)
# SIGNUP_CODE:       optional invite code — when set, POST /api/auth/register requires it
DATABASE_URL=
TEST_DATABASE_URL=
AUTH_SECRET=
SIGNUP_CODE=
