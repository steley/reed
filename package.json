{
  "name": "cloud-reader",
  "version": "0.0.1",
  "private": true,
  "description": "Personal RSS reader on Vercel (Hono) + Turso + GitHub Actions",
  "scripts": {
    "dev": "pnpm --filter @cloud-reader/worker dev",
    "build": "pnpm --filter @cloud-reader/app build",
    "build:api": "pnpm --filter @cloud-reader/worker exec esbuild src/vercel-entry.ts --bundle --platform=node --format=cjs --target=node20 --banner:js=\"/* GENERATED FILE - do not edit. Source: packages/worker/src/vercel-entry.ts. Regenerate with: pnpm build:api */\" --outfile=../../api/index.js",
    "deploy": "vercel deploy --prod",
    "test": "pnpm -r run test",
    "test:run": "pnpm -r run test:run",
    "type-check": "pnpm -r run type-check",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome lint --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@libsql/isomorphic-ws@0.1.5": "patches/@libsql__isomorphic-ws@0.1.5.patch",
      "@libsql/hrana-client@0.9.0": "patches/@libsql__hrana-client@0.9.0.patch",
      "drizzle-orm@0.41.0": "patches/drizzle-orm@0.41.0.patch"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^22.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.7.3"
  }
}
