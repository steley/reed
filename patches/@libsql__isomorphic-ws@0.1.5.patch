diff --git a/node.cjs b/node.cjs
index 00368dfe2656185664e102760b511696f1273286..6af89c2964ceea18c22e97d83454f4cad0ea85f2 100644
--- a/node.cjs
+++ b/node.cjs
@@ -1,3 +1,3 @@
 "use strict";
-const { WebSocket } = require("ws");
-module.exports = { WebSocket };
+// PATCHED (cloud-reader): see node.mjs — no "ws" dependency, global only.
+module.exports = { WebSocket: globalThis.WebSocket };
diff --git a/node.mjs b/node.mjs
index 4ae6dabac8b1038a0d39f4a2f4b43a956f03c183..63bdface9459705d4d108bec23c7ae9356a41ea5 100644
--- a/node.mjs
+++ b/node.mjs
@@ -1,2 +1,6 @@
-import { WebSocket } from "ws";
-export { WebSocket };
+// PATCHED (cloud-reader): drop the "ws" import. The ws package is CJS and
+// crashes esbuild-ESM serverless bundles (@vercel/node: "Dynamic require of
+// stream is not supported") at module load. We only use HTTP transport, so a
+// global WebSocket is enough; ws:// transport is unavailable in Node as a
+// trade-off.
+export const WebSocket = globalThis.WebSocket;
