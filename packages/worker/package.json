{
  "name": "@reed/worker",
  "version": "0.0.1",
  "private": true,
  "description": "REST API (Hono) + Turso/libsql database + cron refresh scripts",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "refresh": "tsx scripts/refresh.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@reed/types": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "fast-xml-parser": "^4.5.3",
    "hono": "^4.12.9"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.4",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.30.4",
    "esbuild": "0.25.12",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
